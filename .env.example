# Mighty No. 9 (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_MN9_*.

# --- PRUDP listeners ---
PN_MN9_AUTH_PORT=28100
PN_MN9_SECURE_PORT=28101
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_MN9_SECURE_HOST=localhost

# --- Database (ranking + DataStore + matchmaking, one database) ---
PN_MN9_POSTGRES_URI=postgres://mn9:mn9@localhost:5432/mn9?sslmode=disable

# --- Kerberos / system accounts ---
PN_MN9_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_MN9_LOCAL_MODE=1
PN_MN9_SETTINGS_PATH=settings.json

# Required only when PN_MN9_LOCAL_MODE is not 1:
PN_MN9_NEX_TOKEN_AES_KEY=
PN_MN9_NEX_PASSWORD_SECRET=

# --- Optional: DataStore object uploads -----
# Only needed if players PUBLISH objects. Downloading works without S3.
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=mn9-datastore
